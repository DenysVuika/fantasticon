{
  "name": "@denysvuika/fantasticon",
  "version": "0.0.0",
  "description": "Icon font generation tool",
  "keywords": [
    "fonts",
    "iconfonts",
    "icons",
    "svg",
    "vector"
  ],
  "homepage": "https://github.com/DenysVuika/fantasticon#readme",
  "bugs": {
    "url": "https://github.com/DenysVuika/fantasticon/issues"
  },
  "license": "MIT",
  "author": "Denys Vuika",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DenysVuika/fantasticon.git"
  },
  "bin": {
    "fantasticon": "bin/fantasticon"
  },
  "files": [
    "bin/fantasticon",
    "dist/**/*",
    "!dist/**/{__mocks__,__tests__}/",
    "templates/*.hbs"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "build": "rimraf dist && tsup",
    "typecheck": "tsc --noEmit --project tsconfig.test.json --noEmit",
    "lint": "oxlint && oxfmt --check ."
  },
  "dependencies": {
    "commander": "^15.0.0",
    "handlebars": "^4.7.9",
    "slugify": "^1.6.9",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/svg2ttf": "^5.0.3",
    "@types/ttf2eot": "^2.0.2",
    "@types/ttf2woff": "^2.0.4",
    "@types/wawoff2": "^1.0.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.88.0",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "jest": {
    "preset": "ts-jest",
    "rootDir": "./src",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json"
        }
      ]
    }
  },
  "engines": {
    "node": ">= 24.14.0"
  },
  "packageManager": "pnpm@10.12.4",
  "prepublish": "build"
}
